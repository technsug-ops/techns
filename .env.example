# Postgres-Verbindung (lokal oder Neon auf Vercel)
DATABASE_URL=postgres://USER:PASSWORT@HOST:5432/DATENBANK

# Langer Zufallswert, z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Nur auf Vercel: Token des Blob-Speichers für hochgeladene Screenshots
BLOB_READ_WRITE_TOKEN=
